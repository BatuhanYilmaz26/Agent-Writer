# Safe local-development defaults. Copy this file to .env and keep real values private.
APP_ENV=development
DEVELOPMENT_MODE=true
AUTH_MODE=local
BIND_HOST=127.0.0.1
PORT=8000
MODEL_PROVIDER=fixture
RESEARCH_PROVIDER=fixture
ENABLE_EXTERNAL_CALLS=false
TOPIC_DISCOVERY=fixture
MODEL_POLICY=free_only
RUN_BUDGET_USD=0
USER_DAILY_BUDGET_USD=0

# Configure your own PostgreSQL runtime role before starting the API/worker.
# DATABASE_URL=
# MIGRATION_DATABASE_URL=

# External providers stay disabled until the qualification gates are satisfied.
# OPENROUTER_API_KEY=
# TREG_TOKEN=
