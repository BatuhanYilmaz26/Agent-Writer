# Local environments and configuration (including nested/renamed dotenv files).
.venv/
venv/
env/
.env
.env.*
*.env
*.env.*
.envrc
!.env.example
.local/
.python-version.local

# Credentials and private key material. Commit sanitized examples deliberately.
.secrets/
secrets/
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
.npmrc
.pypirc
.netrc
.pgpass
.pg_service.conf

# Python/build/tool output. Keep SQL migrations and dependency locks tracked.
